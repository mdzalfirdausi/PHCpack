V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_EXCEPTIONS
RV NO_FLOATING_POINT
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS
RV NO_ELABORATION_CODE
RV NO_OBSOLESCENT_FEATURES

U multprec_floating_numbers%b  multprec_floating_numbers.adb  83368ee6 OO PK
Z ada.exceptions%s	a-except.adb		a-except.ali
W multprec_natural_coefficients%s  multprec_natural_coefficients.adb  multprec_natural_coefficients.ali  AD
W standard_mathematical_functions%s  standard_mathematical_functions.adb  standard_mathematical_functions.ali
Z system.exn_lflt%s	s-exnlfl.ads		s-exnlfl.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U multprec_floating_numbers%s  multprec_floating_numbers.ads  ccc0891a EE NE OO PK
W multprec_integer_numbers%s  multprec_integer_numbers.adb  multprec_integer_numbers.ali
W multprec_natural_numbers%s  multprec_natural_numbers.adb  multprec_natural_numbers.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_integer_numbers%s  standard_integer_numbers.adb  standard_integer_numbers.ali
W standard_natural_numbers%s  standard_natural_numbers.adb  standard_natural_numbers.ali

