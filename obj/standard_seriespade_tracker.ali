W standard_complex_polynomials%s  standard_complex_polynomials.ads  standard_complex_polynomials.ali
W standard_complex_series_vecvecs%s  standard_complex_series_vecvecs.ads  standard_complex_series_vecvecs.ali
W standard_complex_vectors%s  standard_complex_vectors.ads  standard_complex_vectors.ali
