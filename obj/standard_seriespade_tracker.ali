V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_FLOATING_POINT
RV NO_IO
RV NO_LOCAL_ALLOCATORS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U standard_seriespade_tracker%b  standard_seriespade_tracker.adb  313f4c19 NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W homotopy_coefficient_scaling%s  homotopy_coefficient_scaling.adb  homotopy_coefficient_scaling.ali
W homotopy_mixed_residuals%s  homotopy_mixed_residuals.adb  homotopy_mixed_residuals.ali
