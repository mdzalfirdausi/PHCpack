V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_FIXED_POINT
RV NO_IO
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U black_box_polyhedral_solvers%b  black_box_polyhedral_solvers.adb  55b56394 NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
