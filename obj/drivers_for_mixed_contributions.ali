V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_IO
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U drivers_for_mixed_contributions%b  drivers_for_mixed_contributions.adb  c5e0db9d NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W contributions_to_mixed_volume%s  contributions_to_mixed_volume.adb  contributions_to_mixed_volume.ali
W lists_of_integer_vectors%s  lists_of_integer_vectors.ads  lists_of_integer_vectors.ali
W standard_natural_numbers_io%s  standard_natural_numbers_io.adb  standard_natural_numbers_io.ali
