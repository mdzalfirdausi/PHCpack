V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_FLOATING_POINT
RV NO_RECURSION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS

U facet_vertex_enumeration%b  facet_vertex_enumeration.adb  a56b70eb NE OO PK
W linear_minimization%s	linear_minimization.adb	linear_minimization.ali
W standard_floating_norms_equals%s  standard_floating_norms_equals.ads  standard_floating_norms_equals.ali
W standard_integer_vectors%s  standard_integer_vectors.ads  standard_integer_vectors.ali
W standard_random_numbers%s  standard_random_numbers.adb  standard_random_numbers.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U facet_vertex_enumeration%s  facet_vertex_enumeration.ads  a3491fba EE NE OO PK
W lists_of_floating_vectors%s  lists_of_floating_vectors.ads  lists_of_floating_vectors.ali
W lists_of_integer_vectors%s  lists_of_integer_vectors.ads  lists_of_integer_vectors.ali
W standard_floating_matrices%s  standard_floating_matrices.ads  standard_floating_matrices.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_floating_vectors%s  standard_floating_vectors.ads  standard_floating_vectors.ali
W standard_integer_numbers%s  standard_integer_numbers.adb  standard_integer_numbers.ali

