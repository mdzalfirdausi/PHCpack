V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_FLOATING_POINT
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U quaddobl_predictors%b	quaddobl_predictors.adb	1346d989 NE OO PK
W quad_double_constants%s  quad_double_constants.ads  quad_double_constants.ali
W quaddobl_complex_linear_solvers%s  quaddobl_complex_linear_solvers.adb  quaddobl_complex_linear_solvers.ali
