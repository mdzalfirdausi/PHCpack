V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_FLOATING_POINT
RV NO_IMPLEMENTATION_PRAGMAS

U standard_floating_ring.ffield%s  standard_floating_ring-ffield.ads  5b2dcb65 NE OO PK
W abstract_ring%s	abstract_ring.ads	abstract_ring.ali
W abstract_ring.field%s	abstract_ring-field.ads	abstract_ring-field.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_floating_ring%s  standard_floating_ring.ads  standard_floating_ring.ali

D abstract_ring.ads	20260513024558 e7c27303 abstract_ring%s
D abstract_ring-field.ads  20260513024558 41f66d6a abstract_ring.field%s
D standard_floating_numbers.ads  20260513024558 a696816d standard_floating_numbers%s
D standard_floating_ring.ads  20260513024558 756b9342 standard_floating_ring%s
D standard_floating_ring-ffield.ads  20260513024558 bc4d2762 standard_floating_ring.ffield%s
D standard_integer_numbers.ads  20260513024558 7fe0621b standard_integer_numbers%s
D standard_natural_numbers.ads  20260513024558 017761d1 standard_natural_numbers%s
D system.ads		20250808065140 a869df9e system%s
G a e
G c s s s [s standard_floating_ring__ffield 5 1 none]
G r i none [s standard_floating_ring__ffield 5 1 none] [field abstract_ring 12 23 none]
X 1 abstract_ring.ads
25k9*Abstract_Ring 25e29 5|3r6
X 2 abstract_ring-field.ads
12k23 Field 12e35 5|3w20
X 3 standard_floating_numbers.ads
6K9*Standard_Floating_Numbers 58e30 5|2w6 2r47
13F8*double_float<long_float>
28V12*AbsVal{13F8} 5|6r44
46U13*Div 5|6r55
X 4 standard_floating_ring.ads
4K9*Standard_Floating_Ring[1|25] 5|1w6 5r9 6r7
X 5 standard_floating_ring-ffield.ads
5K32*FField[2|12] 4|4k9

