V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_IMPLICIT_CONDITIONALS
RV NO_RECURSION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_OBSOLESCENT_FEATURES

U localization_poset_strings%b  localization_poset_strings.adb  fdda594b NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W characters_and_numbers%s  characters_and_numbers.adb  characters_and_numbers.ali
W standard_integer_numbers%s  standard_integer_numbers.adb  standard_integer_numbers.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U localization_poset_strings%s  localization_poset_strings.ads  2bc555ec EE NE OO PK
W brackets%s		brackets.adb		brackets.ali
W localization_posets%s	localization_posets.adb	localization_posets.ali
W standard_natural_numbers%s  standard_natural_numbers.adb  standard_natural_numbers.ali

