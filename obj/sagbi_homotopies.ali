V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_FLOATING_POINT
RV NO_IMPLICIT_CONDITIONALS
RV NO_LOCAL_ALLOCATORS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U sagbi_homotopies%b	sagbi_homotopies.adb	094e2f81 NE OO PK
Z ada.tags%s		a-tags.adb		a-tags.ali
W bracket_expansions%s	bracket_expansions.adb	bracket_expansions.ali
W bracket_monomials%s	bracket_monomials.adb	bracket_monomials.ali
