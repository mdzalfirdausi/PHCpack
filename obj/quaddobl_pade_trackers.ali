W quad_double_numbers_io%s  quad_double_numbers_io.adb  quad_double_numbers_io.ali
W quaddobl_complex_numbers%s  quaddobl_complex_numbers.ads  quaddobl_complex_numbers.ali
W quaddobl_complex_numbers_cv%s  quaddobl_complex_numbers_cv.adb  quaddobl_complex_numbers_cv.ali
W quaddobl_complex_numbers_io%s  quaddobl_complex_numbers_io.adb  quaddobl_complex_numbers_io.ali
