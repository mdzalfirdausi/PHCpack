V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_FLOATING_POINT
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U standard_floating_two_norms%b  standard_floating_two_norms.adb  0ed9f7d1 NE OO PK
W standard_mathematical_functions%s  standard_mathematical_functions.adb  standard_mathematical_functions.ali

U standard_floating_two_norms%s  standard_floating_two_norms.ads  ba6dfd23 EE NE OO PK
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_floating_vectors%s  standard_floating_vectors.ads  standard_floating_vectors.ali
W standard_floating_vecvecs%s  standard_floating_vecvecs.ads  standard_floating_vecvecs.ali

D abstract_ring.ads	20260513024558 e7c27303 abstract_ring%s
D generic_vectors.ads	20260513024558 8495aef1 generic_vectors%s
D generic_vecvecs.ads	20260513024558 9a9de2b9 generic_vecvecs%s
D standard_floating_numbers.ads  20260513024558 a696816d standard_floating_numbers%s
D standard_floating_ring.ads  20260513024558 756b9342 standard_floating_ring%s
D standard_floating_two_norms.ads  20260513024558 d87b0d08 standard_floating_two_norms%s
D standard_floating_two_norms.adb  20260513024558 ce516948 standard_floating_two_norms%b
D standard_floating_vectors.ads  20260513024558 253a5b14 standard_floating_vectors%s
D standard_floating_vecvecs.ads  20260513024558 e1ba2a52 standard_floating_vecvecs%s
D standard_integer_numbers.ads  20260513024558 7fe0621b standard_integer_numbers%s
D standard_mathematical_functions.ads  20260513024558 18f39391 standard_mathematical_functions%s
D standard_natural_numbers.ads  20260513024558 017761d1 standard_natural_numbers%s
D system.ads		20250808065140 a869df9e system%s
G a e
G c Z s b [norm2 standard_floating_two_norms 10 12 none]
G c Z s b [normalize standard_floating_two_norms 15 13 none]
G c Z s b [normalize standard_floating_two_norms 20 13 none]
G r c none [norm2 standard_floating_two_norms 10 12 none] [sqrt standard_mathematical_functions 40 12 none]
G r c none [normalize standard_floating_two_norms 15 13 none] [sqrt standard_mathematical_functions 40 12 none]
G r c none [normalize standard_floating_two_norms 20 13 none] [sqrt standard_mathematical_functions 40 12 none]
X 2 generic_vectors.ads
16A8*Vector(4|13F8)<10|6I8> 6|10r24[8|4] 15r36[8|4] 7|5r24[8|4] 17r36[8|4]
17P8*Link_to_Vector(16A8[8|4])
X 3 generic_vecvecs.ads
14A8*VecVec(2|17P8[8|4])<10|6I8> 6|20r36[9|5] 7|27r35[9|5]
X 4 standard_floating_numbers.ads
6K9*Standard_Floating_Numbers 58e30 6|1w6 1r46
13F8*double_float<long_float> 6|10r40 7|5r40 7r11 19r20
X 6 standard_floating_two_norms.ads
5K9*Standard_Floating_Two_Norms 25l5 25e32 7|3b14 34l5 34t32
10V12*Norm2{4|13F8} 10>20 7|5b12 15l7 15t12 19s36
10a20 v{2|16A8[8|4]} 7|5b20 10r14 11r20 11r25
15U13*Normalize 15=25 7|17b13 25l7 25t16 30s7
15a25 v{2|16A8[8|4]} 7|17b25 19r42 22r14 23m7 23r15
20U13*Normalize 20=25 7|27b13 32l7 32t16
20a25 v{3|14A8[9|5]} 7|27b24 29r14 30r17
X 7 standard_floating_two_norms.adb
7f5 res{4|13F8} 11m7 11r14 13m5 13r17 14r12
10i9 i<long_integer> 11r22 11r27
19f5 nrm{4|13F8} 23r20
22i9 i<long_integer> 23r9 23r17
29i9 i<long_integer> 30r19
X 8 standard_floating_vectors.ads
4K9*Standard_Floating_Vectors[2|8] 6|2w6 2r46
