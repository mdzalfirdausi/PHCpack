W drivers_for_mixedvol_algorithm%s  drivers_for_mixedvol_algorithm.adb  drivers_for_mixedvol_algorithm.ali
W drivers_for_static_lifting%s  drivers_for_static_lifting.adb  drivers_for_static_lifting.ali
W floating_lifting_functions%s  floating_lifting_functions.adb  floating_lifting_functions.ali
W floating_mixed_subdivisions_io%s  floating_mixed_subdivisions_io.adb  floating_mixed_subdivisions_io.ali
W main_poly_continuation%s  main_poly_continuation.adb  main_poly_continuation.ali
W pipelined_polyhedral_homotopies%s  pipelined_polyhedral_homotopies.adb  pipelined_polyhedral_homotopies.ali
W standard_complex_solutions_io%s  standard_complex_solutions_io.adb  standard_complex_solutions_io.ali
