V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_EXCEPTION_HANDLERS
RV NO_EXCEPTION_PROPAGATION
RV NO_EXCEPTIONS
RV NO_FLOATING_POINT
RV NO_IO
RV NO_IMPLICIT_CONDITIONALS
RV NO_LOCAL_ALLOCATORS
RV NO_LOCAL_PROTECTED_OBJECTS
RV NO_NESTED_FINALIZATION
RV NO_RECURSION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_TASK_HIERARCHY
RV NO_TASKING
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS
RV MAX_TASKS=1+

U multitasking_volume_computation%b  multitasking_volume_computation.adb  d498f483 NE OO PK
Z ada.exceptions%s	a-except.adb		a-except.ali
Z ada.real_time%s	a-reatim.adb		a-reatim.ali
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W lists_of_floating_vectors%s  lists_of_floating_vectors.ads  lists_of_floating_vectors.ali
W multitasking%s	multitasking.adb	multitasking.ali
W semaphore%s		semaphore.adb		semaphore.ali
W standard_floating_vectors%s  standard_floating_vectors.ads  standard_floating_vectors.ali
W standard_integer_linear_solvers%s  standard_integer_linear_solvers.ads  standard_integer_linear_solvers.ali
W standard_natural_numbers_io%s  standard_natural_numbers_io.adb  standard_natural_numbers_io.ali
Z system%s		system.ads		system.ali
Z system.finalization_primitives%s  s-finpri.adb  s-finpri.ali
Z system.parameters%s	s-parame.adb		s-parame.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali
Z system.soft_links%s	s-soflin.adb		s-soflin.ali
Z system.standard_library%s  s-stalib.adb	s-stalib.ali
Z system.task_info%s	s-tasinf.adb		s-tasinf.ali
Z system.tasking%s	s-taskin.adb		s-taskin.ali
Z system.tasking.stages%s  s-tassta.adb		s-tassta.ali
W text_io%s		text_io.ads		text_io.ali
W timing_package%s	timing_package.adb	timing_package.ali

U multitasking_volume_computation%s  multitasking_volume_computation.ads  d9bf43d7 EE NE OO PK
W floating_mixed_subdivisions%s  floating_mixed_subdivisions.adb  floating_mixed_subdivisions.ali
W standard_integer_matrices%s  standard_integer_matrices.ads  standard_integer_matrices.ali
W standard_integer_numbers%s  standard_integer_numbers.adb  standard_integer_numbers.ali
W standard_integer_vectors%s  standard_integer_vectors.ads  standard_integer_vectors.ali
W standard_natural_numbers%s  standard_natural_numbers.adb  standard_natural_numbers.ali

