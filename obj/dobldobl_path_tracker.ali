V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_FLOATING_POINT
RV NO_LOCAL_ALLOCATORS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS
RV NO_ELABORATION_CODE

U dobldobl_path_tracker%b  dobldobl_path_tracker.adb  a57aeb12 OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W continuation_parameters%s  continuation_parameters.adb  continuation_parameters.ali
W dobldobl_complex_equality_tests%s  dobldobl_complex_equality_tests.adb  dobldobl_complex_equality_tests.ali
W dobldobl_complex_vector_norms%s  dobldobl_complex_vector_norms.adb  dobldobl_complex_vector_norms.ali
W dobldobl_complex_vectors%s  dobldobl_complex_vectors.ads  dobldobl_complex_vectors.ali
W dobldobl_correctors%s	dobldobl_correctors.adb	dobldobl_correctors.ali
W dobldobl_data_on_path%s  dobldobl_data_on_path.adb  dobldobl_data_on_path.ali
W dobldobl_dispatch_predictors%s  dobldobl_dispatch_predictors.adb  dobldobl_dispatch_predictors.ali
W dobldobl_homotopy%s	dobldobl_homotopy.adb	dobldobl_homotopy.ali
W dobldobl_random_numbers%s  dobldobl_random_numbers.adb  dobldobl_random_numbers.ali
W double_double_numbers%s  double_double_numbers.adb  double_double_numbers.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U dobldobl_path_tracker%s  dobldobl_path_tracker.ads  7e43925b EE NE OO PK
W dobldobl_complex_numbers%s  dobldobl_complex_numbers.adb  dobldobl_complex_numbers.ali
