V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_FLOATING_POINT
RV NO_IO
RV NO_SECONDARY_STACK
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U pack_continuation_parameters%b  pack_continuation_parameters.adb  44fa07f6 NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
