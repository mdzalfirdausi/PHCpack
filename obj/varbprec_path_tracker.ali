V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_FLOATING_POINT
RV NO_IO
RV NO_LOCAL_ALLOCATORS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_ELABORATION_CODE

U varbprec_path_tracker%b  varbprec_path_tracker.adb  6458c548 OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W continuation_parameters%s  continuation_parameters.adb  continuation_parameters.ali
W solution_string_splitters%s  solution_string_splitters.adb  solution_string_splitters.ali
W standard_complex_poly_strings%s  standard_complex_poly_strings.adb  standard_complex_poly_strings.ali
W standard_complex_poly_systems%s  standard_complex_poly_systems.ads  standard_complex_poly_systems.ali
W standard_complex_solutions%s  standard_complex_solutions.adb  standard_complex_solutions.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_integer_numbers_io%s  standard_integer_numbers_io.adb  standard_integer_numbers_io.ali
W standard_path_tracker%s  standard_path_tracker.adb  standard_path_tracker.ali
W standard_random_numbers%s  standard_random_numbers.adb  standard_random_numbers.ali
W standard_solution_strings%s  standard_solution_strings.adb  standard_solution_strings.ali
W symbol_table%s	symbol_table.adb	symbol_table.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali
W text_io%s		text_io.ads		text_io.ali
W varbprec_corrector_steps%s  varbprec_corrector_steps.adb  varbprec_corrector_steps.ali
W varbprec_homotopy%s	varbprec_homotopy.adb	varbprec_homotopy.ali

U varbprec_path_tracker%s  varbprec_path_tracker.ads  f9e4c975 EE NE OO PK
W standard_complex_numbers%s  standard_complex_numbers.adb  standard_complex_numbers.ali
W standard_integer_numbers%s  standard_integer_numbers.adb  standard_integer_numbers.ali
W standard_natural_numbers%s  standard_natural_numbers.adb  standard_natural_numbers.ali
W string_splitters%s	string_splitters.adb	string_splitters.ali

