V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_FLOATING_POINT
RV NO_IO
RV NO_IMPLICIT_CONDITIONALS
RV NO_LOCAL_ALLOCATORS
RV NO_RECURSION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_TASK_HIERARCHY
RV NO_TASKING
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV MAX_TASKS=1+

U multitasking_continuation%b  multitasking_continuation.adb  75fa730e NE OO PK
Z ada.real_time%s	a-reatim.adb		a-reatim.ali
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W communications_with_user%s  communications_with_user.adb  communications_with_user.ali
W continuation_parameters%s  continuation_parameters.adb  continuation_parameters.ali
W dobldobl_complex_solutions_io%s  dobldobl_complex_solutions_io.adb  dobldobl_complex_solutions_io.ali
W dobldobl_solutions_queue%s  dobldobl_solutions_queue.adb  dobldobl_solutions_queue.ali
W drivers_for_homotopy_creation%s  drivers_for_homotopy_creation.adb  drivers_for_homotopy_creation.ali
W main_poly_continuation%s  main_poly_continuation.adb  main_poly_continuation.ali
W multitasking%s	multitasking.adb	multitasking.ali
W phcpack_operations%s	phcpack_operations.adb	phcpack_operations.ali
W quaddobl_complex_solutions_io%s  quaddobl_complex_solutions_io.adb  quaddobl_complex_solutions_io.ali
W quaddobl_solutions_queue%s  quaddobl_solutions_queue.adb  quaddobl_solutions_queue.ali
W standard_complex_laur_systems_io%s  standard_complex_laur_systems_io.adb  standard_complex_laur_systems_io.ali
W standard_complex_laurentials%s  standard_complex_laurentials.ads  standard_complex_laurentials.ali
W standard_complex_numbers%s  standard_complex_numbers.adb  standard_complex_numbers.ali
W standard_complex_poly_systems_io%s  standard_complex_poly_systems_io.adb  standard_complex_poly_systems_io.ali
W standard_complex_polynomials%s  standard_complex_polynomials.ads  standard_complex_polynomials.ali
W standard_complex_solutions_io%s  standard_complex_solutions_io.adb  standard_complex_solutions_io.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali
W standard_solutions_queue%s  standard_solutions_queue.adb  standard_solutions_queue.ali
W standard_system_and_solutions_io%s  standard_system_and_solutions_io.adb  standard_system_and_solutions_io.ali
Z system%s		system.ads		system.ali
Z system.parameters%s	s-parame.adb		s-parame.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali
Z system.soft_links%s	s-soflin.adb		s-soflin.ali
Z system.task_info%s	s-tasinf.adb		s-tasinf.ali
Z system.tasking%s	s-taskin.adb		s-taskin.ali
Z system.tasking.stages%s  s-tassta.adb		s-tassta.ali
W timing_package%s	timing_package.adb	timing_package.ali

U multitasking_continuation%s  multitasking_continuation.ads  da989511 EE NE OO PK
W dobldobl_complex_solutions%s  dobldobl_complex_solutions.adb  dobldobl_complex_solutions.ali
W quaddobl_complex_solutions%s  quaddobl_complex_solutions.adb  quaddobl_complex_solutions.ali
