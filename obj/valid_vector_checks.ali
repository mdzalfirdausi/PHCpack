V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_FLOATING_POINT
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U valid_vector_checks%b	valid_vector_checks.adb	9252223e NE OO PK
W standard_complex_numbers%s  standard_complex_numbers.adb  standard_complex_numbers.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali

U valid_vector_checks%s	valid_vector_checks.ads	7f1945fb EE NE OO PK
W standard_complex_vectors%s  standard_complex_vectors.ads  standard_complex_vectors.ali
W standard_floating_vectors%s  standard_floating_vectors.ads  standard_floating_vectors.ali

D abstract_ring.ads	20260513024558 e7c27303 abstract_ring%s
D generic_vectors.ads	20260513024558 8495aef1 generic_vectors%s
D standard_complex_numbers.ads  20260513024558 f72bc411 standard_complex_numbers%s
D standard_complex_ring.ads  20260513024558 abe7059e standard_complex_ring%s
D standard_complex_vectors.ads  20260513024558 1daff539 standard_complex_vectors%s
