D s-exctab.ads		20250808065140 91bef6ef system.exception_table%s
D s-parame.ads		20250808065140 3597fc11 system.parameters%s
D s-stalib.ads		20250808065140 1c9580f6 system.standard_library%s
D s-traent.ads		20250808065140 c81cbf8c system.traceback_entries%s
D system_call.ads	20260513024558 e2afd090 system_call%s
D system_call.adb	20260513024558 286de7b9 system_call%b
G a e
G c Z s b [call system_call 6 13 none]
X 4 system.ads
