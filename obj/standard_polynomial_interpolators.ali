V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_FLOATING_POINT
RV NO_LOCAL_ALLOCATORS
RV NO_RECURSION
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_IMPLICIT_LOOPS

U standard_polynomial_interpolators%b  standard_polynomial_interpolators.adb  a6f2f6c9 NE OO PK
