V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_ALLOCATORS
RV NO_FLOATING_POINT
RV NO_LOCAL_ALLOCATORS
RV NO_SECONDARY_STACK
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U standard_sampling_operations%b  standard_sampling_operations.adb  a6c7c6a4 NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W rectangular_sample_grids%s  rectangular_sample_grids.adb  rectangular_sample_grids.ali
W sampling_laurent_machine%s  sampling_laurent_machine.adb  sampling_laurent_machine.ali
