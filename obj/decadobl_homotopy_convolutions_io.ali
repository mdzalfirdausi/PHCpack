V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_IO
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U decadobl_homotopy_convolutions_io%b  decadobl_homotopy_convolutions_io.adb  b951a08e NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W complex_series_and_polynomials%s  complex_series_and_polynomials.adb  complex_series_and_polynomials.ali
