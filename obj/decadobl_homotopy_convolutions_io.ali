W series_and_homotopies%s  series_and_homotopies.adb  series_and_homotopies.ali
W series_path_trackers%s  series_path_trackers.adb  series_path_trackers.ali
W solution_drops%s	solution_drops.adb	solution_drops.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali
W system_convolution_circuits%s  system_convolution_circuits.adb  system_convolution_circuits.ali
W test_series_predictors%s  test_series_predictors.adb  test_series_predictors.ali
W text_io%s		text_io.ads		text_io.ali

U decadobl_homotopy_convolutions_io%s  decadobl_homotopy_convolutions_io.ads  6d10dac4 EE NE OO PK
W decadobl_complex_solutions%s  decadobl_complex_solutions.adb  decadobl_complex_solutions.ali
