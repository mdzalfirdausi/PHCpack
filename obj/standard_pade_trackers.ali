V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_FLOATING_POINT
RV NO_IO
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_DYNAMIC_SIZED_OBJECTS
RV NO_IMPLEMENTATION_PRAGMAS

U standard_pade_trackers%b  standard_pade_trackers.adb  c5785818 NE OO PK
Z ada.strings.text_buffers%s  a-sttebu.adb	a-sttebu.ali
W homotopy_coefficient_scaling%s  homotopy_coefficient_scaling.adb  homotopy_coefficient_scaling.ali
W homotopy_mixed_residuals%s  homotopy_mixed_residuals.adb  homotopy_mixed_residuals.ali
W homotopy_newton_steps%s  homotopy_newton_steps.adb  homotopy_newton_steps.ali
W homotopy_pade_approximants%s  homotopy_pade_approximants.adb  homotopy_pade_approximants.ali
W series_and_homotopies%s  series_and_homotopies.adb  series_and_homotopies.ali
W series_and_predictors%s  series_and_predictors.adb  series_and_predictors.ali
W singular_values_of_hessians%s  singular_values_of_hessians.adb  singular_values_of_hessians.ali
W standard_complex_numbers%s  standard_complex_numbers.adb  standard_complex_numbers.ali
W standard_complex_numbers_io%s  standard_complex_numbers_io.adb  standard_complex_numbers_io.ali
W standard_complex_series_vectors%s  standard_complex_series_vectors.ads  standard_complex_series_vectors.ali
W standard_complex_vector_norms%s  standard_complex_vector_norms.adb  standard_complex_vector_norms.ali
W standard_cseries_vector_functions%s  standard_cseries_vector_functions.adb  standard_cseries_vector_functions.ali
W standard_floating_numbers_io%s  standard_floating_numbers_io.adb  standard_floating_numbers_io.ali
W standard_homotopy%s	standard_homotopy.adb	standard_homotopy.ali
W standard_natural_numbers_io%s  standard_natural_numbers_io.adb  standard_natural_numbers_io.ali
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U standard_pade_trackers%s  standard_pade_trackers.ads  609c62fd EE NE OO PK
W homotopy_continuation_parameters%s  homotopy_continuation_parameters.adb  homotopy_continuation_parameters.ali
W standard_complex_hessians%s  standard_complex_hessians.ads  standard_complex_hessians.ali
