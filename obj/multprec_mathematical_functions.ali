V "GNAT Lib v15"
A -O3
A -gnatA
A -gnatv
A -gnatp
A -gnatf
A -mtune=generic
A -march=x86-64
P ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_EXCEPTIONS
RV NO_FLOATING_POINT
RV NO_STANDARD_STORAGE_POOLS
RV NO_DEFAULT_INITIALIZATION
RV NO_IMPLEMENTATION_PRAGMAS
RV NO_OBSOLESCENT_FEATURES

U multprec_mathematical_functions%b  multprec_mathematical_functions.adb  2ced37e2 NE OO PK
Z ada.exceptions%s	a-except.adb		a-except.ali
W standard_mathematical_functions%s  standard_mathematical_functions.adb  standard_mathematical_functions.ali
W standard_natural_numbers%s  standard_natural_numbers.adb  standard_natural_numbers.ali
Z system.exn_lflt%s	s-exnlfl.ads		s-exnlfl.ali

U multprec_mathematical_functions%s  multprec_mathematical_functions.ads  72631715 EE NE OO PK
W multprec_floating_numbers%s  multprec_floating_numbers.adb  multprec_floating_numbers.ali
W standard_floating_numbers%s  standard_floating_numbers.adb  standard_floating_numbers.ali

